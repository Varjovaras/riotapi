{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100,
    "sortPackageJson": false,
    "sortTailwindcss": {
        "stylesheet": "./src/app.css"
    },
    "svelte": {},
    "associations": [
        {
            "files": ["*.svelte"],
            "language": "svelte"
        }
    ],
    "ignorePatterns": [
        ".DS_Store",
        "node_modules",
        "/build",
        "/.svelte-kit",
        "/package",
        ".env",
        ".env.*",
        "!.env.example",
        "pnpm-lock.yaml",
        "package-lock.json",
        "yarn.lock"
    ]
}
