{
    "name": "my-app",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "trustedDependencies": [
        "lefthook"
    ],
    "scripts": {
        "dev": "vite dev",
        "build": "bun run --bun vite build",
        "preview": "vite preview",
        "start": "bun ./build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "vitest",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check ."
    },
    "devDependencies": {
        "@skeletonlabs/skeleton": "^5.0.1",
        "@sveltejs/adapter-bun": "^1.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.3",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "zod": "^4.6.5"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
